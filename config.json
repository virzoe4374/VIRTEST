  "policy": {
    "levels": {
      "0": {
        "handshake": 10,
        "connIdle": 300,
        "uplinkOnly": 0,
        "downlinkOnly": 0,
        "bufferSize": 2048
      },
      "1": {
        "handshake": 10,
        "connIdle": 300,
        "uplinkOnly": 0,
        "downlinkOnly": 0,
        "bufferSize": 4096
      },
      "2": {
        "handshake": 15,
        "connIdle": 600,
        "uplinkOnly": 0,
        "downlinkOnly": 0,
        "bufferSize": 2048
      }
    },
    "system": {
      "statsInboundUplink": false,
      "statsInboundDownlink": false,
      "statsOutboundUplink": false,
      "statsOutboundDownlink": false
    }
  },
